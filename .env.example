# Docker Compose deployment settings
APP_IMAGE=ghcr.io/peuin/ocdlibary:latest
APP_PORT=3000
PORT=3000
APP_URL=http://localhost:3000

# Database
POSTGRES_USER=bookorbit
POSTGRES_PASSWORD=change-me
POSTGRES_DB=bookorbit

# Auth
JWT_SECRET=change-me-use-openssl-rand-hex-32
SETUP_BOOTSTRAP_TOKEN=change-me-use-openssl-rand-hex-16

# Storage
BOOKS_HOST_PATH=./books
TZ=UTC
PUID=1000
PGID=1000

# Optional app settings
PODCAST_ENCRYPTION_KEY=change-me-use-openssl-rand-hex-32
BOOK_DOCK_PATH=
LIBRARY_BROWSE_ROOT=
DISABLE_LOCAL_AUTH=false
